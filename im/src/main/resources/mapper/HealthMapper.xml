<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qys.im.dao.HealthDao">


    <select id="SelectHealthByUserName" resultType="com.qys.im.pojo.Health">
        select * from health where user_name = #{username} and patient_name = #{patient} order by time desc limit 0,5
    </select>

    <insert id="InsertHealth" parameterType="com.qys.im.pojo.Health">
        insert into health(user_name,patient_name,height,weight,kpa,heartbeat,sports,sleep,time)
        values(#{username},#{patient},#{height},#{weight},#{kpa},#{heart},#{sport},#{sleep},#{time})
    </insert>
</mapper>